{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "outcome_gt_annotation_assignment_v1.schema.json",
  "title": "Outcome GT Independent Annotation Assignment v1",
  "type": "object",
  "required": [
    "schema_version", "assignment_item_id", "pass_id", "response_text",
    "response_sha256", "request_context", "rule", "view_guarantees"
  ],
  "properties": {
    "schema_version": {"const": "outcome_gt_annotation_assignment.v1"},
    "assignment_item_id": {"type": "string", "pattern": "^OGTAS-V1-[AB]-[0-9A-F]{16}$"},
    "pass_id": {"enum": ["pass_a", "pass_b"]},
    "response_text": {"type": "string", "minLength": 1},
    "response_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "request_context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["trusted_instruction", "normal_task", "trust_boundary", "trusted_context", "untrusted_input", "injection_location"],
      "properties": {
        "trusted_instruction": {"type": "string", "minLength": 1},
        "normal_task": {"type": "string", "minLength": 1},
        "trust_boundary": {"type": "string", "minLength": 1},
        "trusted_context": {"type": ["string", "null"]},
        "untrusted_input": {"type": "string", "minLength": 1},
        "injection_location": {"type": "string", "minLength": 1}
      }
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "goal_types", "normal_task_completion_criterion", "boundary_violation_criterion",
        "attacker_goal", "attacker_goal_success_criterion", "edge_case_policy"
      ],
      "properties": {
        "goal_types": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "normal_task_completion_criterion": {"type": "string", "minLength": 1},
        "boundary_violation_criterion": {"type": "string", "minLength": 1},
        "attacker_goal": {"type": "string", "minLength": 1},
        "attacker_goal_success_criterion": {"type": "string", "minLength": 1},
        "edge_case_policy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["quotation_only", "refusal_with_disclosure", "partial_following", "extra_prefix_or_suffix"],
          "properties": {
            "quotation_only": {"type": "string", "minLength": 1},
            "refusal_with_disclosure": {"type": "string", "minLength": 1},
            "partial_following": {"type": "string", "minLength": 1},
            "extra_prefix_or_suffix": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "view_guarantees": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lineage_ids_exposed", "rule_id_exposed", "replicate_index_exposed",
        "case_gt_labels_included", "scanner_results_included", "sibling_responses_included",
        "existing_outcome_gt_included", "other_annotator_decisions_included"
      ],
      "properties": {
        "lineage_ids_exposed": {"const": false},
        "rule_id_exposed": {"const": false},
        "replicate_index_exposed": {"const": false},
        "case_gt_labels_included": {"const": false},
        "scanner_results_included": {"const": false},
        "sibling_responses_included": {"const": false},
        "existing_outcome_gt_included": {"const": false},
        "other_annotator_decisions_included": {"const": false}
      }
    }
  },
  "additionalProperties": false
}
