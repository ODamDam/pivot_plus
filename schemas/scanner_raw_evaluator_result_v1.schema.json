{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "scanner_raw_evaluator_result_v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "scanner_run_id",
    "evaluation_id",
    "generation_id",
    "production_case_id",
    "sample_id",
    "scanner",
    "evaluator",
    "observation_surface",
    "replay_case",
    "observation_sha256",
    "evaluator_input",
    "execution_status",
    "error_type",
    "provenance",
    "native_output",
    "native_output_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": "scanner_raw_evaluator_result.v1"
    },
    "scanner_run_id": {
      "type": "string",
      "minLength": 1
    },
    "evaluation_id": {
      "type": "string",
      "minLength": 1
    },
    "generation_id": {
      "type": "string",
      "minLength": 1
    },
    "production_case_id": {
      "type": "string",
      "minLength": 1
    },
    "sample_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "scanner": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "evaluator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "kind"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "deterministic",
            "llm_judge"
          ]
        }
      }
    },
    "observation_surface": {
      "enum": [
        "response_only",
        "request_and_response",
        "trusted_context_untrusted_input_and_response"
      ]
    },
    "replay_case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity",
        "sha256"
      ],
      "properties": {
        "identity": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "observation_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "evaluator_input": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "identity",
            "sha256"
          ],
          "properties": {
            "identity": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        }
      ]
    },
    "execution_status": {
      "enum": [
        "success",
        "error",
        "timeout",
        "dependency_error",
        "configuration_error",
        "unsupported",
        "skipped"
      ]
    },
    "error_type": {
      "enum": [
        null,
        "adapter_error",
        "scanner_runtime_error",
        "evaluator_error",
        "parser_error",
        "dependency_error",
        "timeout",
        "invalid_native_result",
        "unsupported_result",
        "configuration_error"
      ]
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "adapter_version",
        "git_commit",
        "execution_id",
        "random_seed",
        "configuration",
        "runtime",
        "llm_judge"
      ],
      "properties": {
        "adapter_version": {
          "type": "string",
          "minLength": 1
        },
        "git_commit": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{40}$"
        },
        "execution_id": {
          "type": "string",
          "minLength": 1
        },
        "random_seed": {
          "type": [
            "integer",
            "null"
          ]
        },
        "configuration": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "identity",
            "sha256"
          ],
          "properties": {
            "identity": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        },
        "runtime": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "identifier",
            "python_version",
            "dependencies"
          ],
          "properties": {
            "identifier": {
              "type": "string",
              "minLength": 1
            },
            "python_version": {
              "type": [
                "string",
                "null"
              ]
            },
            "dependencies": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "name",
                  "version"
                ],
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1
                  },
                  "version": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          }
        },
        "llm_judge": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "provider",
                "model",
                "model_version",
                "rubric",
                "random_seed",
                "options",
                "runtime_identifier"
              ],
              "properties": {
                "provider": {
                  "type": "string",
                  "minLength": 1
                },
                "model": {
                  "type": "string",
                  "minLength": 1
                },
                "model_version": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "rubric": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "identity",
                    "sha256"
                  ],
                  "properties": {
                    "identity": {
                      "type": "string",
                      "minLength": 1
                    },
                    "sha256": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$"
                    }
                  }
                },
                "random_seed": {
                  "type": [
                    "integer",
                    "null"
                  ]
                },
                "options": {
                  "type": "object",
                  "additionalProperties": {
                    "$ref": "#/$defs/json"
                  }
                },
                "runtime_identifier": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          ]
        }
      }
    },
    "native_output": {
      "$ref": "#/$defs/json"
    },
    "native_output_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "execution_status": {
            "enum": [
              "success",
              "skipped"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "error_type": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "execution_status": {
            "const": "error"
          }
        }
      },
      "then": {
        "properties": {
          "error_type": {
            "enum": [
              "adapter_error",
              "scanner_runtime_error",
              "evaluator_error",
              "parser_error",
              "dependency_error",
              "timeout",
              "invalid_native_result",
              "unsupported_result",
              "configuration_error"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "execution_status": {
            "const": "timeout"
          }
        }
      },
      "then": {
        "properties": {
          "error_type": {
            "const": "timeout"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "execution_status": {
            "const": "dependency_error"
          }
        }
      },
      "then": {
        "properties": {
          "error_type": {
            "const": "dependency_error"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "execution_status": {
            "const": "configuration_error"
          }
        }
      },
      "then": {
        "properties": {
          "error_type": {
            "const": "configuration_error"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "execution_status": {
            "const": "unsupported"
          }
        }
      },
      "then": {
        "properties": {
          "error_type": {
            "const": "unsupported_result"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "execution_status": {
            "const": "success"
          }
        }
      },
      "then": {
        "properties": {
          "evaluator_input": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "identity",
              "sha256"
            ],
            "properties": {
              "identity": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "evaluator": {
            "properties": {
              "kind": {
                "const": "llm_judge"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "provenance": {
            "properties": {
              "llm_judge": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "provider",
                  "model",
                  "model_version",
                  "rubric",
                  "random_seed",
                  "options",
                  "runtime_identifier"
                ],
                "properties": {
                  "provider": {
                    "type": "string",
                    "minLength": 1
                  },
                  "model": {
                    "type": "string",
                    "minLength": 1
                  },
                  "model_version": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "rubric": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "identity",
                      "sha256"
                    ],
                    "properties": {
                      "identity": {
                        "type": "string",
                        "minLength": 1
                      },
                      "sha256": {
                        "type": "string",
                        "pattern": "^[0-9a-f]{64}$"
                      }
                    }
                  },
                  "random_seed": {
                    "type": [
                      "integer",
                      "null"
                    ]
                  },
                  "options": {
                    "type": "object",
                    "additionalProperties": {
                      "$ref": "#/$defs/json"
                    }
                  },
                  "runtime_identifier": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "provenance": {
            "properties": {
              "llm_judge": {
                "type": "null"
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "json": {
      "anyOf": [
        {
          "type": [
            "null",
            "boolean",
            "number",
            "string"
          ]
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/json"
          }
        },
        {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/json"
          }
        }
      ]
    }
  }
}
