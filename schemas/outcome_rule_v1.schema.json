{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "outcome_rule_v1.schema.json",
  "title": "Outcome Rule v1",
  "type": "object",
  "required": [
    "schema_version", "rule_id", "production_case_id", "source_case_id",
    "rule_catalog_version", "policy_version", "goal_types",
    "normal_task_completion_criterion", "boundary_violation_criterion",
    "attacker_goal", "attacker_goal_success_criterion", "edge_case_policy",
    "binding_provenance", "rule_status"
  ],
  "properties": {
    "schema_version": {"const": "outcome_rule.v1"},
    "rule_id": {"type": "string", "minLength": 1},
    "production_case_id": {"type": "string", "minLength": 1},
    "source_case_id": {"type": "string", "minLength": 1},
    "rule_catalog_version": {"const": "outcome-rule-catalog-v1"},
    "policy_version": {"const": "outcome-gt-contract-v1"},
    "goal_types": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": ["designated_output", "task_redirection", "instruction_override", "synthetic_secret_disclosure", "unauthorized_information_disclosure", "unauthorized_action", "structured_output_manipulation", "other"]
      }
    },
    "normal_task_completion_criterion": {"type": "string", "minLength": 1},
    "boundary_violation_criterion": {"type": "string", "minLength": 1},
    "attacker_goal": {"type": "string", "minLength": 1},
    "attacker_goal_success_criterion": {"type": "string", "minLength": 1},
    "edge_case_policy": {
      "type": "object",
      "required": ["quotation_only", "refusal_with_disclosure", "partial_following", "extra_prefix_or_suffix"],
      "properties": {
        "quotation_only": {"type": "string", "minLength": 1},
        "refusal_with_disclosure": {"type": "string", "minLength": 1},
        "partial_following": {"type": "string", "minLength": 1},
        "extra_prefix_or_suffix": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "binding_provenance": {
      "type": "object",
      "required": ["blind_rule_case_id", "source_artifact_path", "source_artifact_sha256", "execution_plan_path", "execution_plan_sha256", "response_blind", "author", "authored_at"],
      "properties": {
        "blind_rule_case_id": {"type": "string", "minLength": 1},
        "source_artifact_path": {"type": "string", "minLength": 1},
        "source_artifact_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "execution_plan_path": {"type": "string", "minLength": 1},
        "execution_plan_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "response_blind": {"const": true},
        "author": {"type": "string", "minLength": 1},
        "authored_at": {"type": "string", "format": "date-time"}
      },
      "additionalProperties": false
    },
    "rule_status": {"enum": ["draft", "reviewed", "approved", "retired"]}
  },
  "additionalProperties": false
}
