{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dataset_a_ai_first_pass_v1.schema.json",
  "title": "Dataset A AI-assisted first-pass annotation v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "candidate_id": {"type": "string", "pattern": "^DA-RAW-[0-9]{6}$"},
    "record_validity": {"type": "string", "enum": ["valid", "invalid"]},
    "instruction_present": {"type": "boolean"},
    "boundary_evaluable_from_record": {"type": "boolean"},
    "curation_recommendation": {
      "type": "string",
      "enum": ["ready_for_case_gt", "needs_scenario_binding", "needs_harm_context", "exclude_invalid", "human_review"]
    },
    "pi_assessment": {"type": "string", "enum": ["pi", "non_pi", "not_assignable", "boundary_ambiguous", "invalid"]},
    "maliciousness": {"type": "string", "enum": ["malicious", "non_malicious", "uncertain"]},
    "injection_mode": {"type": "string", "enum": ["direct", "indirect", "none", "ambiguous"]},
    "context_dependent": {"type": "boolean"},
    "attack_techniques": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["instruction_override", "escape_or_delimiter_breakout", "fake_completion", "combined_attack", "role_or_authority_impersonation", "system_prompt_extraction", "task_redirection", "designated_output", "format_or_schema_manipulation", "secret_exfiltration", "tool_or_action_hijacking", "obfuscation_or_encoding", "other"]
      }
    },
    "risk_patterns": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["designated_output_override", "task_override", "format_contract_violation", "unauthorized_sensitive_data_exfiltration", "system_prompt_disclosure", "unauthorized_tool_use", "external_side_effect", "integrity_violation", "availability_violation", "safety_control_bypass", "deception_or_impersonation", "none", "other"]
      }
    },
    "hard_negative_type": {
      "type": "string",
      "enum": ["none", "roleplay", "quotation", "translation", "security_discussion", "instruction_about_instructions", "legitimate_role_assignment", "formatting_request", "fictional_attack_text", "authorized_instruction_change", "other"]
    },
    "attacker_goal_summary": {"type": "string", "maxLength": 500},
    "missing_information": {"type": "array", "items": {"type": "string", "maxLength": 200}},
    "evidence_spans": {"type": "array", "maxItems": 3, "items": {"type": "string", "maxLength": 500}},
    "brief_rationale": {"type": "string", "maxLength": 800},
    "confidence": {"type": "string", "enum": ["high", "medium", "low"]},
    "human_review_required": {"type": "boolean"},
    "human_review_reason": {"type": "string", "maxLength": 500}
  },
  "required": [
    "candidate_id", "record_validity", "instruction_present", "boundary_evaluable_from_record",
    "curation_recommendation", "pi_assessment", "maliciousness", "injection_mode", "context_dependent",
    "attack_techniques", "risk_patterns", "hard_negative_type", "attacker_goal_summary",
    "missing_information", "evidence_spans", "brief_rationale", "confidence",
    "human_review_required", "human_review_reason"
  ]
}
