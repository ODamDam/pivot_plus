{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "outcome_rule_binding_exception_v1.schema.json",
  "title": "Outcome Rule Binding Exception v1",
  "type": "object",
  "required": [
    "schema_version", "exception_id", "blind_rule_case_id", "production_case_id",
    "source_case_id", "structural_family", "candidate_template_ids", "reason_code",
    "reason", "review_context", "response_blind", "resolution_status"
  ],
  "properties": {
    "schema_version": {"const": "outcome_rule_binding_exception.v1"},
    "exception_id": {"type": "string", "pattern": "^ORBE-V1-[0-9A-F]{16}$"},
    "blind_rule_case_id": {"type": "string", "pattern": "^ORBI-V1-[0-9A-F]{16}$"},
    "production_case_id": {"type": "string", "minLength": 1},
    "source_case_id": {"type": "string", "minLength": 1},
    "structural_family": {"enum": ["T1_document", "T2_plain_text", "T3_code", "T4_structured", "T5_tool_action"]},
    "candidate_template_ids": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"enum": ["S1", "S2", "S3", "S4", "S5", "S6", "S7", "S8", "S9", "S10", "S11"]}
    },
    "reason_code": {"enum": ["no_confident_template", "ambiguous_compound_goal", "calibration_unexercised_s10", "ambiguous_exactness", "unsupported_pattern"]},
    "reason": {"type": "string", "minLength": 1},
    "review_context": {
      "type": "object",
      "required": ["trusted_instruction", "normal_task", "trust_boundary", "untrusted_input", "injection_location", "source_metadata"],
      "properties": {
        "trusted_instruction": {"type": "string", "minLength": 1},
        "normal_task": {"type": "string", "minLength": 1},
        "trust_boundary": {"type": "string", "minLength": 1},
        "untrusted_input": {"type": "string", "minLength": 1},
        "injection_location": {"type": "string", "minLength": 1},
        "source_metadata": {"type": "object"}
      },
      "additionalProperties": false
    },
    "response_blind": {"const": true},
    "resolution_status": {"const": "pending_human_review"}
  },
  "additionalProperties": false
}
