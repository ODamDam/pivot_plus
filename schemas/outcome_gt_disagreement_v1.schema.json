{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "outcome_gt_disagreement_v1.schema.json",
  "title": "Outcome GT Disagreement v1",
  "type": "object",
  "required": [
    "schema_version", "disagreement_id", "generation_id", "production_case_id",
    "source_case_id", "rule_id", "response_sha256", "differing_fields",
    "pass_a", "pass_b", "adjudication_status"
  ],
  "properties": {
    "schema_version": {"const": "outcome_gt_disagreement.v1"},
    "disagreement_id": {"type": "string", "pattern": "^OGTD-V1-[0-9A-F]{16}$"},
    "generation_id": {"type": "string", "minLength": 1},
    "production_case_id": {"type": "string", "minLength": 1},
    "source_case_id": {"type": "string", "minLength": 1},
    "rule_id": {"type": "string", "minLength": 1},
    "response_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "differing_fields": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "normal_task_completed", "attacker_goal_achieved", "boundary_violated",
          "refusal", "execution_failure", "outcome_label"
        ]
      }
    },
    "pass_a": {"$ref": "#/$defs/snapshot"},
    "pass_b": {"$ref": "#/$defs/snapshot"},
    "adjudication_status": {"const": "pending"}
  },
  "$defs": {
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "quote", "supports"],
      "properties": {
        "source": {"enum": ["response", "request", "rule", "provenance"]},
        "quote": {"type": "string", "minLength": 1},
        "supports": {
          "enum": [
            "boundary_violated", "boundary_preserved", "attacker_goal_achieved",
            "attacker_goal_not_achieved", "normal_task_completed", "refusal",
            "execution_failure", "indeterminate"
          ]
        }
      }
    },
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "annotation_pass", "normal_task_completed", "attacker_goal_achieved",
        "boundary_violated", "refusal", "execution_failure", "outcome_label",
        "evidence", "rationale", "annotator"
      ],
      "properties": {
        "annotation_pass": {"enum": ["first_pass", "second_pass"]},
        "normal_task_completed": {"type": ["boolean", "null"]},
        "attacker_goal_achieved": {"type": ["boolean", "null"]},
        "boundary_violated": {"type": ["boolean", "null"]},
        "refusal": {"type": "boolean"},
        "execution_failure": {"type": "boolean"},
        "outcome_label": {
          "enum": ["attack_success", "partial_compromise", "attack_failure", "refusal", "execution_failure", "indeterminate"]
        },
        "evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}},
        "rationale": {"type": "string", "minLength": 1},
        "annotator": {"type": "string", "minLength": 1}
      }
    }
  },
  "additionalProperties": false
}
