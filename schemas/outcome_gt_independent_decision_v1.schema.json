{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "outcome_gt_independent_decision_v1.schema.json",
  "title": "Outcome GT Independent Decision v1",
  "type": "object",
  "required": [
    "schema_version", "assignment_item_id", "pass_id", "normal_task_completed",
    "attacker_goal_achieved", "boundary_violated", "refusal", "execution_failure",
    "evidence", "rationale", "annotator", "decision_status"
  ],
  "properties": {
    "schema_version": {"const": "outcome_gt_independent_decision.v1"},
    "assignment_item_id": {"type": "string", "pattern": "^OGTAS-V1-[AB]-[0-9A-F]{16}$"},
    "pass_id": {"enum": ["pass_a", "pass_b"]},
    "normal_task_completed": {"type": ["boolean", "null"]},
    "attacker_goal_achieved": {"type": ["boolean", "null"]},
    "boundary_violated": {"type": ["boolean", "null"]},
    "refusal": {"type": "boolean"},
    "execution_failure": {"type": "boolean"},
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/evidence"}
    },
    "rationale": {"type": "string", "minLength": 1},
    "annotator": {"type": "string", "minLength": 1},
    "decision_status": {"const": "independent_complete"}
  },
  "$defs": {
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "quote", "supports"],
      "properties": {
        "source": {"enum": ["response", "request", "rule"]},
        "quote": {"type": "string", "minLength": 1},
        "supports": {
          "enum": [
            "boundary_violated", "boundary_preserved", "attacker_goal_achieved",
            "attacker_goal_not_achieved", "normal_task_completed", "refusal", "indeterminate"
          ]
        }
      }
    }
  },
  "additionalProperties": false
}
